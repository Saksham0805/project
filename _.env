# Copy this file to ".env" and fill it in
PORT=3000

# Any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Gmail SMTP (use an APP PASSWORD, not your real password)
# Google Account -> Security -> 2-Step Verification ON -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM="Campus Radar <yourgmail@gmail.com>"

# Frontend origins allowed to call this API (Live Server)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
